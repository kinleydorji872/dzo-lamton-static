# Copy this file to .env  (or just run:  py start.py --add-key )
# .env is never uploaded to GitHub and is never served to the browser.

# One or more Google AI Studio keys, comma separated. When one is busy the next is used.
GEMINI_API_KEYS=

# Optional: force the model order (default: asked from Google automatically)
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash

# Optional backup service with an OpenAI-style address (Groq, OpenRouter, your own vLLM server ...)
# FALLBACK_BASE=https://api.groq.com/openai/v1
# FALLBACK_KEY=
# FALLBACK_MODEL=llama-3.3-70b-versatile

# Optional: a model on your own computer through Ollama. No limit at all, quality depends on the model.
# OLLAMA_MODEL=qwen2.5:7b

# Optional: Google Cloud Translation (Basic / NMT), an official service that supports Dzongkha.
# Needs a Google Cloud project with billing enabled (card), but the first 500,000 characters per month are free.
# Add it with:  py start.py --add-google-key     (the key is tested with a real translation first)
# GOOGLE_TRANSLATE_KEY=
# The backend counts the characters it sends and stops at this cap so the free allowance cannot be exceeded:
# GOOGLE_MONTHLY_CHAR_CAP=450000
# Which engine translates text:  gemini | google | google+gemini   (google+gemini = Google translates, Gemini polishes the Dzongkha)
# TRANSLATION_ENGINE=gemini
